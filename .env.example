# Public website configuration. Copy to .env.local to override locally.
# Vite embeds VITE_* values at build time (including Netlify).

# Exact approved Google Drive folder for the Windows installer. Do not rewrite
# this into a direct-download or export URL.
VITE_DESKTOP_DOWNLOAD_URL=https://drive.google.com/drive/folders/1nnhXHkcPL2cjl5L7wZVUMPQnb6cnc3_d?usp=sharing

# Optional installer metadata shown next to the download action.
VITE_DESKTOP_VERSION=0.1.1
VITE_DESKTOP_FILENAME=DelvePath_0.1.1_x64-setup.exe
VITE_DESKTOP_SIZE=
VITE_DESKTOP_DATE=
VITE_DESKTOP_SHA256=
VITE_DESKTOP_WINDOWS=Windows 10/11 64-bit
VITE_DESKTOP_GITHUB_RELEASE=

# Canonical source repository (may be private until a public export is approved).
VITE_SOURCE_URL=https://github.com/thejohnhawkwood/delve-path
